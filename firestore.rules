rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidQuotation(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.quoteNumber is string && data.quoteNumber.size() <= 64 &&
             data.createdAt is string && data.createdAt.size() <= 64 &&
             data.grandTotal is number && data.grandTotal >= 0;
    }

    match /saved_quotations/{quotationId} {
      allow read: if true;
      allow create: if isValidId(quotationId) &&
                       isValidQuotation(incoming()) &&
                       incoming().id == quotationId;
      allow update: if isValidId(quotationId) &&
                       isValidQuotation(incoming()) &&
                       incoming().id == quotationId;
      allow delete: if isValidId(quotationId);
    }

    match /app_settings/{settingId} {
      allow read: if true;
      allow write: if isValidId(settingId);
    }

    match /test/{testId} {
      allow read, write: if true;
    }
  }
}
